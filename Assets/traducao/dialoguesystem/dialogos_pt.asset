  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: dialogos_pt
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: pt
  m_SharedData: {fileID: 11400000, guid: 9fd509b263488b943ba7df28ae59ffae, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 15781437440
    m_Localized: "Muito bem! A por\xE7\xE3o esternal do diafragma tem origem na face posterior
      do processo xifoide do esterno."
    m_Metadata:
      m_Items: []
  - m_Id: 18797142016
    m_Localized: "Excelente! As por\xE7\xF5es costais do diafragma t\xEAm origem nas costelas
      inferiores, e suas fibras musculares convergem para o tend\xE3o central."
    m_Metadata:
      m_Items: []
  - m_Id: 21481496576
    m_Localized: "Acertou! O Tend\xE3o Central atua como ponto de ancoragem, fundamental
      para a contra\xE7\xE3o do diafragma!\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 28351766528
    m_Localized: "Excelente! As por\xE7\xF5es costais do diafragma t\xEAm origem nas costelas
      inferiores, e suas fibras musculares convergem para o tend\xE3o central."
    m_Metadata:
      m_Items: []
  - m_Id: 1642579992576
    m_Localized: "Boa escolha! A regi\xE3o Lombar ou tamb\xE9m denominada Crural
      foi capturada corretamente!"
    m_Metadata:
      m_Items: []
  - m_Id: 5320837799936
    m_Localized: "Arraste e encaixe as pe\xE7as certas. Gire a pe\xE7a at\xE9 que fique verde."
    m_Metadata:
      m_Items: []
  - m_Id: 5320837799937
    m_Localized: "Agora mantenha o bot\xE3o esquerdo do mouse pressionado e arraste a
      Esternal at\xE9 a \xE1rea de encaixe."
    m_Metadata:
      m_Items: []
  - m_Id: 5320837799938
    m_Localized: "Clique novamente na Esternal para selecion\xE1-la. Use a seta esquerda
      ou direita para girar a pe\xE7a."
    m_Metadata:
      m_Items: []
  - m_Id: 5320837799939
    m_Localized: "Ajuste a posi\xE7\xE3o e a rota\xE7\xE3o at\xE9 o contorno ficar verde."
    m_Metadata:
      m_Items: []
  - m_Id: 5320837799940
    m_Localized: "Vamos come\xE7ar pela pe\xE7a Esternal. Clique nela para selecion\xE1-la."
    m_Metadata:
      m_Items: []
  - m_Id: 5320837799941
    m_Localized: "Quando a pe\xE7a estiver corretamente encaixada, ela ficar\xE1 verde."
    m_Metadata:
      m_Items: []
  - m_Id: 5320837799942
    m_Localized: "Agora, escolha outra pe\xE7a e encaixe-a na posi\xE7\xE3o correspondente."
    m_Metadata:
      m_Items: []
  - m_Id: 5320837799943
    m_Localized: "Parte correta, mas no local errado. Tente outro local."
    m_Metadata:
      m_Items: []
  - m_Id: 5320837799944
    m_Localized: "Pe\xE7a correta no local correto. Agora s\xF3 falta gir\xE1-la at\xE9 ficar
      na posi\xE7\xE3o correta."
    m_Metadata:
      m_Items: []
  - m_Id: 5320837799945
    m_Localized: "Pe\xE7a incorreta. Ela n\xE3o faz parte do diafragma."
    m_Metadata:
      m_Items: []
  - m_Id: 15622979559424
    m_Localized: Continuar
    m_Metadata:
      m_Items: []
  - m_Id: 30320668024832
    m_Localized: "Seu conhecimento de anatomia est\xE1 afiado!"
    m_Metadata:
      m_Items: []
  - m_Id: 30458320887808
    m_Localized: "O diafragma possui aberturas chamadas hiatos.\r\nEssas aberturas s\xE3o essenciais porque permitem a passagem de estruturas entre o t\xF3rax e o abd\xF4men, como o es\xF4fago, a aorta e a veia cava inferior."
    m_Metadata:
      m_Items: []
  - m_Id: 31329326833664
    m_Localized: "Aperte a tecla de espa\xE7o para ativar / desativar a rota\xE7\xE3o
      autom\xE1tica"
    m_Metadata:
      m_Items: []
  - m_Id: 31627214692352
    m_Localized: Arraste o Diafragma para visualiza-lo por completo, e utilize a
      roda do mouse para aumentar ou diminuir o zoom.
    m_Metadata:
      m_Items: []
  - m_Id: 39075803668480
    m_Localized: "O diafragma possui aberturas chamadas hiatos.\r\nEssas aberturas
      s\xE3o essenciais porque permitem a passagem de estruturas entre o t\xF3rax
      e o abd\xF4men, como o es\xF4fago, a aorta e a veia cava inferior."
    m_Metadata:
      m_Items: []
  - m_Id: 52080826228736
    m_Localized: "Aqui passa a veia cava inferior, principal veia onde flui sangue
      desoxigenadodo corpo para o cora\xE7\xE3o.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 52086371098624
    m_Localized: "O hiato esof\xE1gico permite a passagem do es\xF4fago, que conduz
      o alimento at\xE9 o est\xF4mago.\r\n\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 52088552136704
    m_Localized: "Por aqui passa a aorta, principal art\xE9ria onde flui sangue oxigenado
      do cora\xE7\xE3o para o corpo."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
